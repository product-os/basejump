{
  "name": "basejump",
  "version": "0.4.3",
  "private": true,
  "description": "A GitHub app for rebasing on demand",
  "author": "Balena",
  "license": "Apache-2.0",
  "homepage": "https://github.com/product-os/basejump",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "typecheck": "tsc",
    "lint": "balena-lint -e ts src test",
    "lint:fix": "balena-lint --fix -e ts src test",
    "start": "probot run ./src/index.ts",
    "test": "npm run typecheck && vitest",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "dependencies": {
    "probot": "^13.4.5",
    "simple-git": "^4.0.0"
  },
  "devDependencies": {
    "@balena/lint": "^9.3.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nock": "15.0.2",
    "smee-client": "4.4.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">= 24",
    "npm": ">= 11"
  },
  "type": "module",
  "versionist": {
    "publishedAt": "2026-10-27T11:15:19.814Z"
  }
}
